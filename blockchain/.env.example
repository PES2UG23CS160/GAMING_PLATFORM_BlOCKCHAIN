# Blockchain Environment Variables (for testnet/mainnet deployment)

# 12-word mnemonic phrase for deployment account
MNEMONIC=your twelve word seed phrase goes here

# Infura Project ID (get from infura.io)
INFURA_KEY=your_infura_project_id_here

# Note: Keep these values SECRET and never commit to git!
# For local development (Ganache), you don't need this file.
